{
  "name": "echo-the-awakening",
  "private": true,
  "version": "0.1.0",
  "description": "A cinematic browser sci-fi experience with optional on-device AI and deterministic gameplay.",
  "license": "MIT",
  "homepage": "https://echo-the-awakening.pages.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/AVL05/echo-the-awakening.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "prebuild": "npm run lint && npm test && node scripts/licenses.mjs",
    "postbuild": "node scripts/check-dist.mjs",
    "check:release": "node scripts/check-dist.mjs",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.86",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "4.1.12"
  }
}
